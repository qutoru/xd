# Bybit API credentials (public kline endpoint does not require them,
# but they are loaded if present). Copy this file to .env and fill in.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Bybit TESTNET keys (from https://testnet.bybit.com -> API Management) ---
# Used automatically when BYBIT_TESTNET=true; falls back to BYBIT_API_KEY/SECRET
# above if left empty.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Telegram notifications (Phase 6). Create a bot via @BotFather for the token,
# and get your chat id (e.g. from @userinfobot). Leave empty to use --dry-run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Telegram user id allowed to run bot admin commands (/grant, /revoke, /subs,
# /users). Get it from @userinfobot. Leave empty to disable admin commands.
TELEGRAM_ADMIN_ID=
BYBIT_TRADING_MODE=paper
# Slippage cap on triggered stop-loss closes. > 0 places the stop as a stop-LIMIT
# whose limit sits this fraction beyond the trigger (0.01 = 1%), so a close can't
# sweep a thin book to any price. 0 = legacy stop-MARKET (guaranteed exit, no cap).
BYBIT_STOP_SLIPPAGE_TOL=0.01

# --- Semi-auto signal delivery (owner Accept/Ignore) ---
# Enable the owner buttoned-approval flow (orders placed on Accept).
TRADE_SEMI_AUTO=1
# Quality filter: deliver only the strongest N signals per rebalance instead of the
# whole cross-sectional book. 0 = no cap (deliver every signal above the floor).
SIGNAL_TOP_N=5
# Drop any signal whose normalized confidence is below this floor (0..1).
SIGNAL_MIN_CONFIDENCE=0.0
# Liquidity allowlist (comma-separated). ALX still ranks across the full universe;
# only signals on these symbols are surfaced for execution. Guards against venues
# (e.g. Bybit testnet) where illiquid symbols reject market entries (retCode 30208).
# Empty/unset = no gate (deliver every symbol).
TRADE_LIQUID_SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT,XRPUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT,ICPUSDT
# In-process driver (runs inside `main.py bot`): how often to recompute the ALX
# book, and how fast queued signals are released (default 60s = one per minute).
SIGNAL_CYCLE_INTERVAL_S=86400
SIGNAL_RELEASE_INTERVAL_S=60
